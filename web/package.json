{
  "name": "klean-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Klean web client (M26): Vite + TypeScript + M3E web components, served by the backend at /",
  "scripts": {
    "gen": "node scripts/tokens.mjs && node scripts/assets.mjs",
    "build": "pnpm gen && tsc --noEmit && vite build && node scripts/check-copy.mjs dist",
    "dev": "pnpm gen && vite",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "pnpm gen && vitest run && node scripts/check-copy.mjs src",
    "check-copy": "node scripts/check-copy.mjs src",
    "typecheck": "tsc --noEmit",
    "e2e": "sh e2e/run.sh",
    "visual": "playwright test --project=visual",
    "review": "playwright test --project=review"
  },
  "dependencies": {
    "@m3e/web": "2.12.0",
    "lit": "3.3.3",
    "qrcode-generator": "2.0.4",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.9.0"
}
