<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".notification.StatusRepostReceiver"
            android:exported="false" />
        <receiver
            android:name=".notification.DietReplyReceiver"
            android:exported="false" />
        <receiver
            android:name=".notification.PromptDismissReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.DietWidgetReceiver"
            android:exported="true"
            android:label="@string/diet_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diet_widget_info" />
        </receiver>
    </application>
</manifest>
