<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview of the medium widget layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/diet_widget_preview_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/diet_widget_preview_pill"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/diet_widget_prompt"
        android:textColor="#FF0B2A20"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/diet_widget_empty"
        android:textColor="#FF49454F"
        android:textSize="14sp" />
</LinearLayout>
