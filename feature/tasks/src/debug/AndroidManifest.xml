<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: `adb shell am broadcast -a app.klean.debug.TASK_REVIEW -p app.klean.debug` shows the
     "Still want these?" notification now, if anything from earlier days is still open. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="app.klean.feature.tasks.review.TaskReviewReceiver"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="${applicationId}.TASK_REVIEW" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
