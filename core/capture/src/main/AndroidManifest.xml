<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice entries. Requested just in time, the first time the mic is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility (API 30+): lets SpeechRecognizer find the system recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <!-- Exported for app shortcuts and Assistant/App Actions (res/xml/shortcuts.xml targets it by class).
             It only opens the sheet, prefilled at most; nothing is saved until the person taps Save. -->
        <activity
            android:name=".CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity="app.klean.capture"
            android:theme="@style/Theme.Klean.Translucent"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <receiver
            android:name=".status.StatusReplyReceiver"
            android:exported="false" />
        <receiver
            android:name=".status.StatusRepostReceiver"
            android:exported="false" />

        <service
            android:name=".CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
