<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview of the medium Today widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_preview_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/today_widget_label"
        android:textColor="#FF1D1B20"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/today_widget_preview_pill"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/today_quick_voice"
        android:textColor="#FF1D1A3A"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/today_widget_empty"
        android:textColor="#FF49454F"
        android:textSize="14sp" />
</LinearLayout>
