<?xml version="1.0" encoding="utf-8"?>
<!-- Klean mark: a day ring (open circle) with a check inside and a dot in the ring's opening
     ("your day, handled"). No food imagery. The glyph sits inside the 66dp adaptive-icon safe zone
     centred at 54,54. Also used as the themed (monochrome) icon, which only reads the alpha. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ring: 300° arc, radius 22, centred (54,54), opening 60° wide at the top right (-75°..-15°) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 59.69,32.75 A 22,22 0 1,0 75.25,48.31"
        android:strokeWidth="6"
        android:strokeColor="#4C3F8B"
        android:strokeLineCap="round" />
    <!-- dot: on the ring's radius, in the middle of the opening (-45°) -->
    <path
        android:fillColor="#4C3F8B"
        android:pathData="M 69.56,38.44 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />
    <!-- check -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 43.5,55 L 50.5,62 L 63,49.5"
        android:strokeWidth="6"
        android:strokeColor="#4C3F8B"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
